# Copy this file to ".env" and put your own key there.
# NEVER put a real key in this file. NEVER commit ".env".

API_KEY=your_api_key_here

# --- Option A: OpenAI (default) ---
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# --- Option B: Groq (free tier) ---
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# --- Option C: Google Gemini (free tier) ---
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-2.0-flash

# --- Optional settings (defaults shown) ---
# MAX_HISTORY=20            # max messages sent to the AI
# MAX_HISTORY_CHARS=12000   # max total characters sent to the AI
# MAX_MESSAGE_CHARS=2000    # max length of one user message
# RATE_LIMIT_PER_MIN=20     # requests allowed per IP per minute
# REQUEST_TIMEOUT=30        # seconds to wait for the AI
# FLASK_DEBUG=0             # set to 1 only while developing
# SYSTEM_PROMPT=...         # one line; replaces the default CodeBuddy prompt
